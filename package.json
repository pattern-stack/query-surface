{
  "name": "@pattern-stack/query-surface",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent-aware semantic query + aggregation surface (describe/query/fetch/aggregate/compare) over a host schema \u2014 hexagonal, backend-pluggable.",
  "license": "FSL-1.1-MIT",
  "author": "Pattern Stack",
  "homepage": "https://github.com/pattern-stack/query-surface#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pattern-stack/query-surface.git"
  },
  "bugs": {
    "url": "https://github.com/pattern-stack/query-surface/issues"
  },
  "keywords": [
    "semantic-layer",
    "query",
    "aggregation",
    "analytics",
    "metrics",
    "drizzle",
    "drizzle-orm",
    "postgres",
    "mcp",
    "agents",
    "llm-tools",
    "nestjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/presentation/nest/index.d.ts",
      "import": "./dist/presentation/nest/index.js",
      "default": "./dist/presentation/nest/index.js"
    },
    "./mcp": {
      "types": "./dist/presentation/mcp/index.d.ts",
      "import": "./dist/presentation/mcp/index.js",
      "default": "./dist/presentation/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run build:types && bun run build:js",
    "build:types": "tsc -p tsconfig.build.json && bun scripts/fix-dts-specifiers.ts dist",
    "build:js": "bun build src/index.ts src/presentation/nest/index.ts src/presentation/mcp/index.ts --root src --outdir dist --target node --format esm --splitting --packages external",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "check:type": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "rxjs": "^7.0.0",
    "typescript": "^5",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.21.0",
    "rxjs": "^7.0.0",
    "sql-formatter": "^15.8.1",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  }
}
